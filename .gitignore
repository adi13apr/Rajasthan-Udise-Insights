# Raw UDISE+ downloads are not redistributed (portal data-sharing terms); download them from the portal (see README)
data/raw/
# Generated data layers: rebuilt by the pipeline from data/raw
data/processed/school_year.csv
data/bronze/
data/silver/
data/gold/*
# ...except the district-level marts, which are fine to publish
!data/gold/exports/
data/quarantine/
data/delta/
data/tmp/
*.duckdb
*.duckdb.wal
# Logs and debug output from the downloader
download_log.txt
debug/
__pycache__/
.pytest_cache/
.ipynb_checkpoints/

# Synthetic sample data (regenerated by run_pipeline.py --sample) and sample outputs
tests/fixtures/raw/
data/sample/
# Tableau autosave / recovery files
*.twbr
# Power BI: the CSV export is school-level (UDISE+ data-sharing terms), and so is any .pbix
# (it embeds the data). Commit only the reference files, the manifest and .pbit templates.
powerbi/data/*
!powerbi/data/README.md
!powerbi/data/official_totals.csv
!powerbi/data/norms.csv
!powerbi/data/export_manifest.json
*.pbix
# Power BI project caches: .pbi/cache.abf holds the loaded (school-level) data
powerbi/**/.pbi/
