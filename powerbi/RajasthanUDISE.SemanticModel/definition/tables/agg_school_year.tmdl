	column teachers_required =
			VAR p_ppt = LOOKUPVALUE ( norms[pupils_per_teacher], norms[stage], "primary" )
			VAR p_min = LOOKUPVALUE ( norms[min_teachers], norms[stage], "primary" )
			VAR u_ppt = LOOKUPVALUE ( norms[pupils_per_teacher], norms[stage], "upper_primary" )
			VAR u_min = LOOKUPVALUE ( norms[min_teachers], norms[stage], "upper_primary" )
			VAR s_ppt = LOOKUPVALUE ( norms[pupils_per_teacher], norms[stage], "secondary" )
			VAR s_min = LOOKUPVALUE ( norms[min_teachers], norms[stage], "secondary" )
			VAR h_ppt = LOOKUPVALUE ( norms[pupils_per_teacher], norms[stage], "higher_secondary" )
			VAR h_min = LOOKUPVALUE ( norms[min_teachers], norms[stage], "higher_secondary" )
			VAR p = agg_school_year[enr_primary]
			VAR u = agg_school_year[enr_upper_primary]
			VAR s = agg_school_year[enr_secondary]
			VAR h = agg_school_year[enr_higher_secondary]
			RETURN
			    IF ( p > 0, MAX ( p_min, ROUNDUP ( p / p_ppt, 0 ) ), 0 )
			        + IF ( u > 0, MAX ( u_min, ROUNDUP ( u / u_ppt, 0 ) ), 0 )
			        + IF ( s > 0, MAX ( s_min, ROUNDUP ( s / s_ppt, 0 ) ), 0 )
			        + IF ( h > 0, MAX ( h_min, ROUNDUP ( h / h_ppt, 0 ) ), 0 )
		formatString: 0
		lineageTag: e9193318-d3d4-53c8-a64b-4f3d33956857
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column teachers_for_norms = agg_school_year[teachers] - agg_school_year[teachers_pre_primary_only]
		formatString: 0
		lineageTag: 4a446979-90c3-50e2-a846-d489fe0aa9ed
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition agg_school_year = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "agg_school_year.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(Headers, {{"school_key", Int64.Type}, {"year_key", Int64.Type}, {"enr_pre_primary", Int64.Type}, {"enr_1_12", Int64.Type}, {"enr_girls_1_12", Int64.Type}, {"enr_primary", Int64.Type}, {"enr_primary_g", Int64.Type}, {"enr_upper_primary", Int64.Type}, {"enr_secondary", Int64.Type}, {"enr_higher_secondary", Int64.Type}, {"enr_secondary_plus", Int64.Type}, {"enr_secondary_plus_g", Int64.Type}, {"teachers", Int64.Type}, {"teachers_pre_primary_only", Int64.Type}, {"single_teacher", Int64.Type}, {"classrooms", Int64.Type}, {"classrooms_usable", Int64.Type}, {"infra_index", type number}, {"has_electricity", type number}, {"has_safe_water", type number}, {"has_girls_toilet", type number}, {"has_boys_toilet", type number}, {"has_handwash", type number}, {"has_library", type number}, {"has_playground", type number}, {"has_ramp", type number}, {"has_internet", type number}, {"has_computer", type number}}, "en-US")
			in
			    Typed

	annotation PBI_ResultType = Table
