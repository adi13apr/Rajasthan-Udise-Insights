	partition official_totals = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "official_totals.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    Typed = Table.TransformColumnTypes(Headers, {{"year", type text}, {"indicator", type text}, {"indicator_label", type text}, {"official_value", Int64.Type}, {"official_source", type text}}, "en-US")
			in
			    Typed

	annotation PBI_ResultType = Table
