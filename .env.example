# Settings for the RAG agent (python -m rag.ask). Copy to .env (gitignored) and fill in.
# Any OpenAI-compatible provider works: OpenAI, Azure OpenAI, Google Gemini, Groq, a local server.

# Google Gemini (OpenAI-compatible endpoint). For OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# gemini-3.5-flash-lite: 500 requests/day on the free tier, so every run (and the phase 5 eval)
# uses one model. gemini-3.5-flash allows only 20/day; gemini-2.5-flash is closed to new keys (404);
# gemini-3.8-flash was overloaded (503) on 2026-11-09.
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=

# Rate limits of your key (0 = no limit). The client waits before a call that would exceed them.
# Check yours at https://aistudio.google.com/rate-limit. Free tier on 2026-11-09: gemini-3.5-flash
# (listed there as Gemini 3.6 Flash) 5 RPM, 250,000 TPM, 20 requests/day; gemini-3.5-flash-lite
# 15 RPM, 250,000 TPM, 500/day. The daily quota (not checked here) resets at midnight Pacific time.
LLM_TPM_LIMIT=250000
LLM_RPM_LIMIT=15
# Seconds before one LLM call is abandoned.
LLM_TIMEOUT_S=60
# Output token cap per call; thinking models count their thinking tokens here too.
LLM_MAX_OUTPUT_TOKENS=4096
# Optional: reasoning effort for models that "think" (e.g. none, low, medium). Blank = provider default.
LLM_REASONING_EFFORT=
# How structured output is requested: json_schema (default), json_object, or none (prompt only).
LLM_JSON_MODE=json_schema

# Agent budgets
AGENT_MAX_LLM_CALLS=5
# full = whole schema card in the SQL prompt; sliced = only the sections for the relevant tables
LLM_SCHEMA_CARD=sliced
