            <column datatype="real" name="pct_single_teacher_2024" ordinal="6" />
            <column datatype="real" name="pct_single_teacher_2025" ordinal="7" />
            <column datatype="integer" name="teachers_2024" ordinal="8" />
            <column datatype="integer" name="teachers_2025" ordinal="9" />
