<?xml version='1.0' encoding='utf-8' ?>
<workbook xmlns:user="http://www.tableausoftware.com/xml/user" original-version="18.1" source-build="2018.1.0 (20181.18.0404.1112)" source-platform="win" version="18.1">
  <preferences>
    <color-palette custom="true" name="Rajasthan Gender patterns" type="regular">
      <color>#1baf7a</color>
      <color>#2a78d6</color>
      <color>#eb6834</color>
      <color>#d3d2cb</color>
    </color-palette>
    <color-palette custom="true" name="Rajasthan Government vs private" type="regular">
      <color>#2a78d6</color>
      <color>#eb6834</color>
    </color-palette>
  </preferences>
  <datasources>
    <datasource hasconnection="false" inline="true" name="Parameters" version="18.1">
      <aliases enabled="yes" />
      <column caption="Year" datatype="string" name="[Parameter 1]" param-domain-type="list" role="measure" type="nominal" value="&quot;2025-26&quot;">
        <calculation class="tableau" formula="&quot;2025-26&quot;" />
        <members>
          <member value="&quot;2024-25&quot;" />
          <member value="&quot;2025-26&quot;" />
        </members>
      </column>
      <column caption="Indicator" datatype="string" name="[Parameter 2]" param-domain-type="list" role="measure" type="nominal" value="&quot;Infrastructure index&quot;">
        <calculation class="tableau" formula="&quot;Infrastructure index&quot;" />
        <members>
          <member value="&quot;Infrastructure index&quot;" />
          <member value="&quot;Single-teacher schools (%)&quot;" />
          <member value="&quot;Students per teacher&quot;" />
          <member value="&quot;Girls' retention gap (points)&quot;" />
        </members>
      </column>
    </datasource>
    <datasource caption="District indicators" inline="true" name="federated.b3k8z3indoove3bikohnzselorje" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="tableau_district_indicators" name="textscan.districts">
            <connection class="textscan" directory="Data/Datasources" filename="tableau_district_indicators.csv" password="" server="" />
          </named-connection>
        </named-connections>
        <relation connection="textscan.districts" name="tableau_district_indicators.csv" table="[tableau_district_indicators#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator=",">
            <column datatype="string" name="district" ordinal="0" />
            <column datatype="string" name="district_label" ordinal="1" />
            <column datatype="string" name="year" ordinal="2" />
            <column datatype="integer" name="schools" ordinal="3" />
            <column datatype="integer" name="enrolment" ordinal="4" />
            <column datatype="real" name="girls_share" ordinal="5" />
            <column datatype="real" name="girls_share_primary" ordinal="6" />
            <column datatype="real" name="girls_share_sec_plus" ordinal="7" />
            <column datatype="real" name="st_share" ordinal="8" />
            <column datatype="real" name="sc_share" ordinal="9" />
            <column datatype="integer" name="teachers" ordinal="10" />
            <column datatype="real" name="ptr" ordinal="11" />
            <column datatype="real" name="pct_single_teacher" ordinal="12" />
            <column datatype="real" name="avg_infra_index" ordinal="13" />
            <column datatype="real" name="girls_retention_gap" ordinal="14" />
            <column datatype="real" name="boys_progression" ordinal="15" />
            <column datatype="real" name="girls_progression" ordinal="16" />
            <column datatype="real" name="pct_has_electricity" ordinal="17" />
            <column datatype="real" name="pct_has_safe_water" ordinal="18" />
            <column datatype="real" name="pct_has_girls_toilet" ordinal="19" />
            <column datatype="real" name="pct_has_boys_toilet" ordinal="20" />
            <column datatype="real" name="pct_has_handwash" ordinal="21" />
            <column datatype="real" name="pct_has_library" ordinal="22" />
            <column datatype="real" name="pct_has_playground" ordinal="23" />
            <column datatype="real" name="pct_has_ramp" ordinal="24" />
            <column datatype="real" name="pct_has_internet" ordinal="25" />
            <column datatype="real" name="pct_has_computer" ordinal="26" />
            <column datatype="string" name="pattern" ordinal="27" />
            <column datatype="real" name="single_teacher_change_matched_pp" ordinal="28" />
            <column datatype="real" name="teachers_change_matched_pct" ordinal="29" />
            <column datatype="integer" name="rank_avg_infra_index" ordinal="30" />
            <column datatype="integer" name="rank_pct_single_teacher" ordinal="31" />
            <column datatype="integer" name="rank_ptr" ordinal="32" />
            <column datatype="integer" name="rank_girls_retention_gap" ordinal="33" />
            <column datatype="string" name="state" ordinal="34" />
          </columns>
        </relation>
      </connection>
      <aliases enabled="yes" />
      <column datatype="string" name="[district]" role="dimension" type="nominal" />
      <column caption="District" datatype="string" name="[district_label]" role="dimension" type="nominal" />
      <column datatype="string" name="[year]" role="dimension" type="nominal" />
      <column caption="Schools" datatype="integer" name="[schools]" role="measure" type="quantitative" />
      <column caption="Students (classes 1-12)" datatype="integer" name="[enrolment]" role="measure" type="quantitative" />
      <column datatype="real" name="[girls_share]" role="measure" type="quantitative" />
      <column datatype="real" name="[girls_share_primary]" role="measure" type="quantitative" />
      <column datatype="real" name="[girls_share_sec_plus]" role="measure" type="quantitative" />
      <column datatype="real" name="[st_share]" role="measure" type="quantitative" />
      <column datatype="real" name="[sc_share]" role="measure" type="quantitative" />
      <column caption="Teachers" datatype="integer" name="[teachers]" role="measure" type="quantitative" />
      <column caption="Students per teacher" datatype="real" name="[ptr]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0" />
      <column caption="Single-teacher schools (%)" datatype="real" name="[pct_single_teacher]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0" />
      <column caption="Infrastructure index" datatype="real" name="[avg_infra_index]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0" />
      <column datatype="real" name="[girls_retention_gap]" role="measure" type="quantitative" />
      <column caption="Boys' progression ratio" datatype="real" name="[boys_progression]" role="measure" type="quantitative" default-format="n#,##0.00;-#,##0.00" />
      <column caption="Girls' progression ratio" datatype="real" name="[girls_progression]" role="measure" type="quantitative" default-format="n#,##0.00;-#,##0.00" />
      <column datatype="real" name="[pct_has_electricity]" role="measure" type="quantitative" />
      <column datatype="real" name="[pct_has_safe_water]" role="measure" type="quantitative" />
      <column datatype="real" name="[pct_has_girls_toilet]" role="measure" type="quantitative" />
      <column datatype="real" name="[pct_has_boys_toilet]" role="measure" type="quantitative" />
      <column datatype="real" name="[pct_has_handwash]" role="measure" type="quantitative" />
      <column datatype="real" name="[pct_has_library]" role="measure" type="quantitative" />
      <column datatype="real" name="[pct_has_playground]" role="measure" type="quantitative" />
      <column datatype="real" name="[pct_has_ramp]" role="measure" type="quantitative" />
      <column datatype="real" name="[pct_has_internet]" role="measure" type="quantitative" />
      <column datatype="real" name="[pct_has_computer]" role="measure" type="quantitative" />
      <column caption="Gender pattern" datatype="string" name="[pattern]" role="dimension" type="nominal" />
      <column datatype="real" name="[single_teacher_change_matched_pp]" role="measure" type="quantitative" />
      <column datatype="real" name="[teachers_change_matched_pct]" role="measure" type="quantitative" />
      <column datatype="integer" name="[rank_avg_infra_index]" role="measure" type="quantitative" />
      <column datatype="integer" name="[rank_pct_single_teacher]" role="measure" type="quantitative" />
      <column datatype="integer" name="[rank_ptr]" role="measure" type="quantitative" />
      <column datatype="integer" name="[rank_girls_retention_gap]" role="measure" type="quantitative" />
      <column datatype="string" name="[state]" role="dimension" type="nominal" />
      <column caption="Selected year" datatype="boolean" name="[Calc_SelectedYear]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[year] = [Parameters].[Parameter 1]" />
      </column>
      <column caption="Indicator value" datatype="real" name="[Calc_Indicator]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0">
        <calculation class="tableau" formula="CASE [Parameters].[Parameter 2] WHEN &quot;Infrastructure index&quot; THEN [avg_infra_index] WHEN &quot;Single-teacher schools (%)&quot; THEN [pct_single_teacher] WHEN &quot;Students per teacher&quot; THEN [ptr] WHEN &quot;Girls' retention gap (points)&quot; THEN [girls_retention_gap] * 100 END" />
      </column>
      <column caption="Rank (1 = worst)" datatype="integer" name="[Calc_Rank]" role="measure" type="quantitative">
        <calculation class="tableau" formula="CASE [Parameters].[Parameter 2] WHEN &quot;Infrastructure index&quot; THEN [rank_avg_infra_index] WHEN &quot;Single-teacher schools (%)&quot; THEN [rank_pct_single_teacher] WHEN &quot;Students per teacher&quot; THEN [rank_ptr] WHEN &quot;Girls' retention gap (points)&quot; THEN [rank_girls_retention_gap] END" />
      </column>
      <column caption="Highlight" datatype="string" name="[Calc_Worst10]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF CASE [Parameters].[Parameter 2] WHEN &quot;Infrastructure index&quot; THEN [rank_avg_infra_index] WHEN &quot;Single-teacher schools (%)&quot; THEN [rank_pct_single_teacher] WHEN &quot;Students per teacher&quot; THEN [rank_ptr] WHEN &quot;Girls' retention gap (points)&quot; THEN [rank_girls_retention_gap] END &lt;= 10 THEN &quot;Worst 10&quot; ELSE &quot;Other districts&quot; END" />
      </column>
      <column caption="Among the worst 10" datatype="integer" name="[Calc_Worst10Flag]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF CASE [Parameters].[Parameter 2] WHEN &quot;Infrastructure index&quot; THEN [rank_avg_infra_index] WHEN &quot;Single-teacher schools (%)&quot; THEN [rank_pct_single_teacher] WHEN &quot;Students per teacher&quot; THEN [rank_ptr] WHEN &quot;Girls' retention gap (points)&quot; THEN [rank_girls_retention_gap] END &lt;= 10 THEN 1 ELSE 0 END" />
      </column>
      <column caption="Tribal-majority south" datatype="integer" name="[Calc_TribalFlag]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [district] = &quot;BANSWARA&quot; OR [district] = &quot;DUNGARPUR&quot; OR [district] = &quot;PRATAPGARH&quot; OR [district] = &quot;SALUMBAR&quot; OR [district] = &quot;UDAIPUR&quot; THEN 1 ELSE 0 END" />
      </column>
      <column caption="Students (crore)" datatype="real" name="[Calc_StudentsCrore]" role="measure" type="quantitative" default-format="n#,##0.00;-#,##0.00">
        <calculation class="tableau" formula="SUM([enrolment]) / 10000000" />
      </column>
      <column caption="Teachers (lakh)" datatype="real" name="[Calc_TeachersLakh]" role="measure" type="quantitative" default-format="n#,##0.00;-#,##0.00">
        <calculation class="tableau" formula="SUM([teachers]) / 100000" />
      </column>
      <column caption="Students per teacher (state)" datatype="real" name="[Calc_StatePTR]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0">
        <calculation class="tableau" formula="SUM([enrolment]) / SUM([teachers])" />
      </column>
      <column caption="Single-teacher schools % (state)" datatype="real" name="[Calc_StateSingle]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0">
        <calculation class="tableau" formula="SUM([pct_single_teacher] * [schools]) / SUM([schools])" />
      </column>
      <column caption="Infrastructure index (state)" datatype="real" name="[Calc_StateInfra]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0">
        <calculation class="tableau" formula="SUM([avg_infra_index] * [schools]) / SUM([schools])" />
      </column>
      <column caption="Region" datatype="string" name="[Calc_TribalSouth]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [district] = &quot;BANSWARA&quot; OR [district] = &quot;DUNGARPUR&quot; OR [district] = &quot;PRATAPGARH&quot; OR [district] = &quot;SALUMBAR&quot; OR [district] = &quot;UDAIPUR&quot; THEN &quot;Tribal-majority south&quot; ELSE &quot;Other districts&quot; END" />
      </column>
      <column caption="Label" datatype="string" name="[Calc_TribalLabel]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [district] = &quot;BANSWARA&quot; OR [district] = &quot;DUNGARPUR&quot; OR [district] = &quot;PRATAPGARH&quot; OR [district] = &quot;SALUMBAR&quot; OR [district] = &quot;UDAIPUR&quot; THEN [district_label] END" />
      </column>
      <column caption="Label" datatype="string" name="[Calc_PatternLabel]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [pattern] &lt;&gt; &quot;other&quot; THEN [district_label] END" />
      </column>
      <extract count="-1" enabled="true" units="records">
        <connection class="hyper" dbname="Data/Extracts/districts.hyper" default-settings="yes" schema="Extract" tablename="Extract" update-time="10/21/2026 10:00:00 AM">
          <relation name="Extract" table="[Extract].[Extract]" type="table" />
        </connection>
      </extract>
      <layout dim-ordering="alphabetic" dim-percentage="0.5" measure-ordering="alphabetic" measure-percentage="0.4" show-structure="true" />
    </datasource>
