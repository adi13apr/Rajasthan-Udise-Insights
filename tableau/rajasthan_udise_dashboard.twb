      <connection class="federated">
        <named-connections>
          <named-connection caption="a4_single_teacher_change_matched" name="textscan.matched">
            <connection class="textscan" directory="Data/Datasources" filename="a4_single_teacher_change_matched.csv" password="" server="" />
          </named-connection>
        </named-connections>
