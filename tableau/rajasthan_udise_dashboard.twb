      <column caption="Girls' retention gap (points)" datatype="real" name="[Calc_GapPts]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0">
        <calculation class="tableau" formula="[girls_retention_gap] * 100" />
      </column>
      <extract count="-1" enabled="true" units="records">
        <connection class="hyper" dbname="Data/Extracts/sector.hyper" default-settings="yes" schema="Extract" tablename="Extract" update-time="10/21/2026 10:00:00 AM">
