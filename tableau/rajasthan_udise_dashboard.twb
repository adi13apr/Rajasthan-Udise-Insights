      <column datatype="integer" name="[schools_2024]" role="measure" type="quantitative" />
      <column datatype="integer" name="[schools_2025]" role="measure" type="quantitative" />
      <column datatype="integer" name="[single_teacher_schools_2024]" role="measure" type="quantitative" />
      <column datatype="integer" name="[single_teacher_schools_2025]" role="measure" type="quantitative" />
      <column datatype="real" name="[pct_single_teacher_2024]" role="measure" type="quantitative" />
      <column datatype="real" name="[pct_single_teacher_2025]" role="measure" type="quantitative" />
      <column datatype="integer" name="[teachers_2024]" role="measure" type="quantitative" />
      <column datatype="integer" name="[teachers_2025]" role="measure" type="quantitative" />
      <column caption="Change in single-teacher schools (points)" datatype="real" name="[change_pp]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0" />
      <column datatype="real" name="[teachers_change_pct]" role="measure" type="quantitative" />
      <column caption="Western desert" datatype="integer" name="[Calc_DesertFlag]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [district] = &quot;JAISALMER&quot; OR [district] = &quot;BARMER&quot; OR [district] = &quot;PHALODI&quot; OR [district] = &quot;BALOTRA&quot; THEN 1 ELSE 0 END" />
      </column>
      <column caption="Region" datatype="string" name="[Calc_Desert]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [district] = &quot;JAISALMER&quot; OR [district] = &quot;BARMER&quot; OR [district] = &quot;PHALODI&quot; OR [district] = &quot;BALOTRA&quot; THEN &quot;Western desert&quot; ELSE &quot;Other districts&quot; END" />
      </column>
      <extract count="-1" enabled="true" units="records">
        <connection class="hyper" dbname="Data/Extracts/matched.hyper" default-settings="yes" schema="Extract" tablename="Extract" update-time="10/21/2026 10:00:00 AM">
          <relation name="Extract" table="[Extract].[Extract]" type="table" />
        </connection>
      </extract>
      <layout dim-ordering="alphabetic" dim-percentage="0.5" measure-ordering="alphabetic" measure-percentage="0.4" show-structure="true" />
    </datasource>
