    <worksheet name="Single-teacher change">
      <layout-options>
        <title>
          <formatted-text>
            <run fontname="Segoe UI" bold="true" fontsize="13">Change in single-teacher schools, 2024-25 to 2025-26 (points)</run>
            <run fontname="Segoe UI" fontsize="10" fontcolor="#52514e">  same schools in both years; western desert in dark blue</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Single-teacher change (same schools)" name="federated.2d12l1a5lr43rm5ux3u8wzmznjz1" />
          </datasources>
          <datasource-dependencies datasource="federated.2d12l1a5lr43rm5ux3u8wzmznjz1">
            <column datatype="string" name="[district_label]" role="dimension" type="nominal" />
            <column datatype="real" name="[change_pp]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0" />
            <column datatype="integer" name="[Calc_DesertFlag]" role="measure" type="quantitative" caption="Western desert">
              <calculation class="tableau" formula="IF [district] = &quot;JAISALMER&quot; OR [district] = &quot;BARMER&quot; OR [district] = &quot;PHALODI&quot; OR [district] = &quot;BALOTRA&quot; THEN 1 ELSE 0 END" />
            </column>
            <column-instance column="[district_label]" derivation="None" name="[none:district_label:nk]" pivot="key" type="nominal" />
            <column-instance column="[change_pp]" derivation="Sum" name="[sum:change_pp:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Calc_DesertFlag]" derivation="Max" name="[max:Calc_DesertFlag:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <sort class="computed" column="[federated.2d12l1a5lr43rm5ux3u8wzmznjz1].[none:district_label:nk]" direction="DESC" using="[federated.2d12l1a5lr43rm5ux3u8wzmznjz1].[sum:change_pp:qk]" />
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[federated.2d12l1a5lr43rm5ux3u8wzmznjz1].[max:Calc_DesertFlag:qk]" />
              <text column="[federated.2d12l1a5lr43rm5ux3u8wzmznjz1].[sum:change_pp:qk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.2d12l1a5lr43rm5ux3u8wzmznjz1].[none:district_label:nk]</rows>
        <cols>[federated.2d12l1a5lr43rm5ux3u8wzmznjz1].[sum:change_pp:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Infrastructure vs single-teacher">
      <layout-options>
        <title>
          <formatted-text>
            <run fontname="Segoe UI" bold="true" fontsize="13">Infrastructure vs single-teacher schools, &lt;[Parameters].[Parameter 1]&gt;</run>
            <run fontname="Segoe UI" fontsize="10" fontcolor="#52514e">  tribal-majority south in dark blue</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="District indicators" name="federated.b3k8z3indoove3bikohnzselorje" />
          </datasources>
          <datasource-dependencies datasource="federated.b3k8z3indoove3bikohnzselorje">
            <column datatype="real" name="[avg_infra_index]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0" />
            <column datatype="real" name="[pct_single_teacher]" role="measure" type="quantitative" default-format="n#,##0.0;-#,##0.0" />
            <column datatype="string" name="[district_label]" role="dimension" type="nominal" />
            <column datatype="integer" name="[Calc_TribalFlag]" role="measure" type="quantitative" caption="Tribal-majority south">
              <calculation class="tableau" formula="IF [district] = &quot;BANSWARA&quot; OR [district] = &quot;DUNGARPUR&quot; OR [district] = &quot;PRATAPGARH&quot; OR [district] = &quot;SALUMBAR&quot; OR [district] = &quot;UDAIPUR&quot; THEN 1 ELSE 0 END" />
            </column>
            <column datatype="string" name="[Calc_TribalLabel]" role="dimension" type="nominal" caption="Label">
              <calculation class="tableau" formula="IF [district] = &quot;BANSWARA&quot; OR [district] = &quot;DUNGARPUR&quot; OR [district] = &quot;PRATAPGARH&quot; OR [district] = &quot;SALUMBAR&quot; OR [district] = &quot;UDAIPUR&quot; THEN [district_label] END" />
            </column>
            <column datatype="boolean" name="[Calc_SelectedYear]" role="dimension" type="nominal" caption="Selected year">
              <calculation class="tableau" formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column-instance column="[avg_infra_index]" derivation="Sum" name="[sum:avg_infra_index:qk]" pivot="key" type="quantitative" />
            <column-instance column="[pct_single_teacher]" derivation="Sum" name="[sum:pct_single_teacher:qk]" pivot="key" type="quantitative" />
            <column-instance column="[district_label]" derivation="None" name="[none:district_label:nk]" pivot="key" type="nominal" />
            <column-instance column="[Calc_TribalFlag]" derivation="Max" name="[max:Calc_TribalFlag:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Calc_TribalLabel]" derivation="None" name="[none:Calc_TribalLabel:nk]" pivot="key" type="nominal" />
            <column-instance column="[Calc_SelectedYear]" derivation="None" name="[none:Calc_SelectedYear:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.b3k8z3indoove3bikohnzselorje].[none:Calc_SelectedYear:nk]">
            <groupfilter function="member" level="[none:Calc_SelectedYear:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Circle" />
            <encodings>
              <color column="[federated.b3k8z3indoove3bikohnzselorje].[max:Calc_TribalFlag:qk]" />
              <text column="[federated.b3k8z3indoove3bikohnzselorje].[none:Calc_TribalLabel:nk]" />
              <lod column="[federated.b3k8z3indoove3bikohnzselorje].[none:district_label:nk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.b3k8z3indoove3bikohnzselorje].[sum:avg_infra_index:qk]</rows>
        <cols>[federated.b3k8z3indoove3bikohnzselorje].[sum:pct_single_teacher:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
