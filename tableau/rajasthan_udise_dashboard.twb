  </datasources>
  <worksheets>
    <worksheet name="KPI Schools">
      <layout-options>
        <title>
          <formatted-text>
            <run fontname="Segoe UI" fontsize="9" fontcolor="#52514e">Schools with students</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="District indicators" name="federated.b3k8z3indoove3bikohnzselorje" />
          </datasources>
          <datasource-dependencies datasource="federated.b3k8z3indoove3bikohnzselorje">
            <column datatype="integer" name="[schools]" role="measure" type="quantitative" />
            <column datatype="boolean" name="[Calc_SelectedYear]" role="dimension" type="nominal" caption="Selected year">
              <calculation class="tableau" formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column-instance column="[schools]" derivation="Sum" name="[sum:schools:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Calc_SelectedYear]" derivation="None" name="[none:Calc_SelectedYear:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.b3k8z3indoove3bikohnzselorje].[none:Calc_SelectedYear:nk]">
            <groupfilter function="member" level="[none:Calc_SelectedYear:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <mark-sizing mark-sizing-setting="marks-scaling-off" />
            <encodings>
              <text column="[federated.b3k8z3indoove3bikohnzselorje].[sum:schools:qk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
                <format attr="font-size" value="26" />
                <format attr="font-family" value="Segoe UI" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
    <worksheet name="KPI Students">
      <layout-options>
        <title>
          <formatted-text>
            <run fontname="Segoe UI" fontsize="9" fontcolor="#52514e">Students, classes 1-12 (crore)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="District indicators" name="federated.b3k8z3indoove3bikohnzselorje" />
          </datasources>
          <datasource-dependencies datasource="federated.b3k8z3indoove3bikohnzselorje">
            <column datatype="real" name="[Calc_StudentsCrore]" role="measure" type="quantitative" caption="Students (crore)" default-format="n#,##0.00;-#,##0.00">
              <calculation class="tableau" formula="SUM([enrolment]) / 10000000" />
            </column>
            <column datatype="boolean" name="[Calc_SelectedYear]" role="dimension" type="nominal" caption="Selected year">
              <calculation class="tableau" formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column-instance column="[Calc_StudentsCrore]" derivation="User" name="[usr:Calc_StudentsCrore:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Calc_SelectedYear]" derivation="None" name="[none:Calc_SelectedYear:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.b3k8z3indoove3bikohnzselorje].[none:Calc_SelectedYear:nk]">
