    <worksheet name="District ranking">
      <layout-options>
        <title>
          <formatted-text>
            <run fontname="Segoe UI" bold="true" fontsize="13">&lt;[Parameters].[Parameter 2]&gt;, &lt;[Parameters].[Parameter 1]&gt;</run>
            <run fontname="Segoe UI" fontsize="10" fontcolor="#52514e">  worst 10 in dark blue; rank 1 at the top</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="District indicators" name="federated.b3k8z3indoove3bikohnzselorje" />
          </datasources>
          <datasource-dependencies datasource="federated.b3k8z3indoove3bikohnzselorje">
            <column datatype="string" name="[district_label]" role="dimension" type="nominal" />
            <column datatype="real" name="[Calc_Indicator]" role="measure" type="quantitative" caption="Indicator value" default-format="n#,##0.0;-#,##0.0">
              <calculation class="tableau" formula="CASE [Parameters].[Parameter 2] WHEN &quot;Infrastructure index&quot; THEN [avg_infra_index] WHEN &quot;Single-teacher schools (%)&quot; THEN [pct_single_teacher] WHEN &quot;Students per teacher&quot; THEN [ptr] WHEN &quot;Girls' retention gap (points)&quot; THEN [girls_retention_gap] * 100 END" />
            </column>
            <column datatype="integer" name="[Calc_Worst10Flag]" role="measure" type="quantitative" caption="Among the worst 10">
              <calculation class="tableau" formula="IF CASE [Parameters].[Parameter 2] WHEN &quot;Infrastructure index&quot; THEN [rank_avg_infra_index] WHEN &quot;Single-teacher schools (%)&quot; THEN [rank_pct_single_teacher] WHEN &quot;Students per teacher&quot; THEN [rank_ptr] WHEN &quot;Girls' retention gap (points)&quot; THEN [rank_girls_retention_gap] END &lt;= 10 THEN 1 ELSE 0 END" />
            </column>
            <column datatype="boolean" name="[Calc_SelectedYear]" role="dimension" type="nominal" caption="Selected year">
              <calculation class="tableau" formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column datatype="integer" name="[Calc_Rank]" role="measure" type="quantitative" caption="Rank (1 = worst)">
              <calculation class="tableau" formula="CASE [Parameters].[Parameter 2] WHEN &quot;Infrastructure index&quot; THEN [rank_avg_infra_index] WHEN &quot;Single-teacher schools (%)&quot; THEN [rank_pct_single_teacher] WHEN &quot;Students per teacher&quot; THEN [rank_ptr] WHEN &quot;Girls' retention gap (points)&quot; THEN [rank_girls_retention_gap] END" />
            </column>
            <column-instance column="[district_label]" derivation="None" name="[none:district_label:nk]" pivot="key" type="nominal" />
            <column-instance column="[Calc_Indicator]" derivation="Sum" name="[sum:Calc_Indicator:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Calc_Worst10Flag]" derivation="Max" name="[max:Calc_Worst10Flag:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Calc_SelectedYear]" derivation="None" name="[none:Calc_SelectedYear:nk]" pivot="key" type="nominal" />
            <column-instance column="[Calc_Rank]" derivation="Sum" name="[sum:Calc_Rank:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.b3k8z3indoove3bikohnzselorje].[none:Calc_SelectedYear:nk]">
            <groupfilter function="member" level="[none:Calc_SelectedYear:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <sort class="computed" column="[federated.b3k8z3indoove3bikohnzselorje].[none:district_label:nk]" direction="ASC" using="[federated.b3k8z3indoove3bikohnzselorje].[sum:Calc_Rank:qk]" />
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[federated.b3k8z3indoove3bikohnzselorje].[max:Calc_Worst10Flag:qk]" />
              <text column="[federated.b3k8z3indoove3bikohnzselorje].[sum:Calc_Indicator:qk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.b3k8z3indoove3bikohnzselorje].[none:district_label:nk]</rows>
        <cols>[federated.b3k8z3indoove3bikohnzselorje].[sum:Calc_Indicator:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Gender patterns">
      <layout-options>
        <title>
          <formatted-text>
            <run fontname="Segoe UI" bold="true" fontsize="13">Boys' vs girls' progression ratio, &lt;[Parameters].[Parameter 1]&gt;</run>
            <run fontname="Segoe UI" fontsize="10" fontcolor="#52514e">  students per grade in classes 9-12 / classes 1-5</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="District indicators" name="federated.b3k8z3indoove3bikohnzselorje" />
          </datasources>
          <datasource-dependencies datasource="federated.b3k8z3indoove3bikohnzselorje">
            <column datatype="real" name="[girls_progression]" role="measure" type="quantitative" default-format="n#,##0.00;-#,##0.00" />
            <column datatype="real" name="[boys_progression]" role="measure" type="quantitative" default-format="n#,##0.00;-#,##0.00" />
            <column datatype="string" name="[district_label]" role="dimension" type="nominal" />
            <column datatype="string" name="[pattern]" role="dimension" type="nominal" />
            <column datatype="string" name="[Calc_PatternLabel]" role="dimension" type="nominal" caption="Label">
              <calculation class="tableau" formula="IF [pattern] &lt;&gt; &quot;other&quot; THEN [district_label] END" />
            </column>
            <column datatype="boolean" name="[Calc_SelectedYear]" role="dimension" type="nominal" caption="Selected year">
              <calculation class="tableau" formula="[year] = [Parameters].[Parameter 1]" />
            </column>
            <column-instance column="[girls_progression]" derivation="Sum" name="[sum:girls_progression:qk]" pivot="key" type="quantitative" />
            <column-instance column="[boys_progression]" derivation="Sum" name="[sum:boys_progression:qk]" pivot="key" type="quantitative" />
            <column-instance column="[district_label]" derivation="None" name="[none:district_label:nk]" pivot="key" type="nominal" />
            <column-instance column="[pattern]" derivation="None" name="[none:pattern:nk]" pivot="key" type="nominal" />
            <column-instance column="[Calc_PatternLabel]" derivation="None" name="[none:Calc_PatternLabel:nk]" pivot="key" type="nominal" />
            <column-instance column="[Calc_SelectedYear]" derivation="None" name="[none:Calc_SelectedYear:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.b3k8z3indoove3bikohnzselorje].[none:Calc_SelectedYear:nk]">
            <groupfilter function="member" level="[none:Calc_SelectedYear:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="mark">
            <encoding attr="color" field="[federated.b3k8z3indoove3bikohnzselorje].[none:pattern:nk]" palette="Rajasthan Gender patterns" type="palette">
              <color-palette custom="true" name="Rajasthan Gender patterns" type="regular">
                <color>#1baf7a</color>
                <color>#2a78d6</color>
                <color>#eb6834</color>
                <color>#d3d2cb</color>
              </color-palette>
              <map to="#eb6834">
                <bucket>"girls leaving"</bucket>
              </map>
              <map to="#2a78d6">
                <bucket>"boys moving in"</bucket>
              </map>
              <map to="#1baf7a">
                <bucket>"boys leaving (tribal south)"</bucket>
              </map>
              <map to="#d3d2cb">
                <bucket>"other"</bucket>
              </map>
            </encoding>
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Circle" />
            <encodings>
              <color column="[federated.b3k8z3indoove3bikohnzselorje].[none:pattern:nk]" />
              <text column="[federated.b3k8z3indoove3bikohnzselorje].[none:Calc_PatternLabel:nk]" />
              <lod column="[federated.b3k8z3indoove3bikohnzselorje].[none:district_label:nk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.b3k8z3indoove3bikohnzselorje].[sum:girls_progression:qk]</rows>
        <cols>[federated.b3k8z3indoove3bikohnzselorje].[sum:boys_progression:qk]</cols>
      </table>
    </worksheet>
